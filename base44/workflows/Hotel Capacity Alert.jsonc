{
  "name": "Hotel Capacity Alert",
  "description": "",
  "trigger": {
    "condition": "${ (.trigger.data.status != \"cancelled\" and .trigger.data.status != \"rejected\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "HotelBooking"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "hotel_capacity_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkHotelCapacity",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}