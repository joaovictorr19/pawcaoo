{
  "name": "Email Walker - New Booking",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.data.walker_email != null) or (.trigger.data.trainer_email != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Booking"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "email_walker_new_booking",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyWalkerNewBooking",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}