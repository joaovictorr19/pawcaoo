{
  "name": "Pedir Review ap\u00f3s Sess\u00e3o de Treino Conclu\u00edda",
  "description": "Quando uma TrainingBooking passa a 'completed', envia email a pedir avalia\u00e7\u00e3o. Ap\u00f3s 24h, se ainda n\u00e3o existir Review, reenvia lembrete.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "TrainingBooking",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"completed\" and .trigger.old_data.status != \"completed\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "training_review_request",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_first_email": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendTrainingReviewEmail",
            "args": {
              "booking_id": "${ .trigger.entity_id }",
              "email_type": "first"
            }
          },
          "then": "wait_24h",
          "x-base44": {
            "title": "Enviar email de pedido de avalia\u00e7\u00e3o",
            "description": "Email imediato ap\u00f3s concluir a sess\u00e3o"
          }
        }
      },
      {
        "wait_24h": {
          "wait": "PT24H",
          "then": "send_reminder",
          "x-base44": {
            "title": "Aguardar 24 horas",
            "description": "Dar tempo ao cliente para avaliar"
          }
        }
      },
      {
        "send_reminder": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendTrainingReviewEmail",
            "args": {
              "booking_id": "${ .trigger.entity_id }",
              "email_type": "reminder"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Enviar lembrete se sem avalia\u00e7\u00e3o",
            "description": "S\u00f3 envia se ainda n\u00e3o existir Review"
          }
        }
      }
    ]
  }
}