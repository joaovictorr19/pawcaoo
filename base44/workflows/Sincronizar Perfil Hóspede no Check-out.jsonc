{
  "name": "Sincronizar Perfil H\u00f3spede no Check-out",
  "description": "Cria ou atualiza a ficha de cliente e o perfil dos c\u00e3es quando uma reserva \u00e9 confirmada, marcada como checked_out ou completed",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"confirmed\") or (.trigger.data.status == \"checked_out\") or (.trigger.data.status == \"completed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "HotelBooking"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sincronizar_perfil_h_spede_no_check_out",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncGuestProfile",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncGuestProfile"
  }
}