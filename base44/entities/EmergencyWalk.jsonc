{
  "name": "EmergencyWalk",
  "type": "object",
  "properties": {
    "dogs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dog_name": {
            "type": "string"
          },
          "dog_photo_url": {
            "type": "string"
          },
          "dog_size": {
            "type": "string",
            "enum": [
              "small",
              "medium",
              "large",
              "extra_large"
            ]
          },
          "dog_breed": {
            "type": "string"
          }
        }
      },
      "description": "Lista de c\u00e3es para o passeio",
      "default": []
    },
    "dog_name": {
      "type": "string",
      "description": "Name of the dog (deprecated - use dogs array)"
    },
    "dog_photo_url": {
      "type": "string",
      "description": "Photo of the dog (deprecated - use dogs array)"
    },
    "dog_size": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large",
        "extra_large"
      ]
    },
    "dog_breed": {
      "type": "string",
      "description": "Breed of the dog (deprecated - use dogs array)"
    },
    "total_dogs": {
      "type": "number",
      "default": 1,
      "description": "N\u00famero total de c\u00e3es no passeio"
    },
    "owner_name": {
      "type": "string",
      "description": "Name of the dog owner"
    },
    "owner_phone": {
      "type": "string",
      "description": "Phone number of the owner"
    },
    "location": {
      "type": "string",
      "description": "Where the dog needs to be picked up"
    },
    "needed_time": {
      "type": "string",
      "description": "When the walk is needed (e.g., 'Now', 'In 30 mins', 'In 1 hour')"
    },
    "duration_hours": {
      "type": "number",
      "description": "How long the walk should be",
      "default": 1
    },
    "service_amount": {
      "type": "number",
      "description": "Amount the walker will receive"
    },
    "platform_fee": {
      "type": "number",
      "description": "Commission taken by platform"
    },
    "offered_amount": {
      "type": "number",
      "description": "Total amount the owner will pay"
    },
    "special_notes": {
      "type": "string",
      "description": "Important info about the dog (temperament, medical needs, etc.)"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "accepted",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "available",
      "description": "Status of the emergency walk"
    },
    "accepted_by_walker": {
      "type": "string",
      "description": "Email of the walker who accepted"
    },
    "walker_name": {
      "type": "string",
      "description": "Name of the walker who accepted"
    },
    "urgency_level": {
      "type": "string",
      "enum": [
        "urgent",
        "very_urgent",
        "immediate"
      ],
      "default": "urgent",
      "description": "How urgent the walk is needed"
    },
    "payment_id": {
      "type": "string",
      "description": "ID of the associated payment record"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "held",
        "released",
        "refunded"
      ],
      "default": "pending"
    },
    "completion_code": {
      "type": "string",
      "description": "Code that walker provides to owner to confirm walk completion"
    },
    "completed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the walk was marked as completed"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description"
    }
  },
  "required": [
    "owner_name",
    "owner_phone",
    "location",
    "offered_amount"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "accepted_by_walker": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "status": "available"
        },
        {
          "data.owner_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "accepted_by_walker": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}