{
  "name": "DogProfile",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string",
      "description": "Email do dono",
      "default": "{{user.email}}"
    },
    "owner_phone": {
      "type": "string",
      "description": "Telefone do dono"
    },
    "pickup_address": {
      "type": "string",
      "description": "Endere\u00e7o padr\u00e3o de recolha do animal"
    },
    "pickup_city": {
      "type": "string",
      "description": "Cidade de recolha"
    },
    "pickup_postal_code": {
      "type": "string",
      "description": "C\u00f3digo postal"
    },
    "pickup_latitude": {
      "type": "number"
    },
    "pickup_longitude": {
      "type": "number"
    },
    "animal_type": {
      "type": "string",
      "enum": [
        "dog",
        "cat",
        "reptile",
        "arachnid",
        "rodent",
        "bird"
      ],
      "default": "dog"
    },
    "dog_name": {
      "type": "string",
      "description": "Nome do pet"
    },
    "photo_url": {
      "type": "string"
    },
    "gallery_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "breed": {
      "type": "string"
    },
    "age": {
      "type": "number"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "weight": {
      "type": "number",
      "description": "Peso em kg"
    },
    "size": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large",
        "extra_large"
      ]
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ]
    },
    "color": {
      "type": "string"
    },
    "is_adopted": {
      "type": "boolean",
      "default": false
    },
    "adoption_date": {
      "type": "string",
      "format": "date"
    },
    "adoption_story": {
      "type": "string"
    },
    "microchip_number": {
      "type": "string"
    },
    "is_neutered": {
      "type": "boolean",
      "default": false
    },
    "is_vaccinated": {
      "type": "boolean",
      "default": true
    },
    "vaccination_date": {
      "type": "string",
      "format": "date"
    },
    "vaccination_records": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "vet_name": {
      "type": "string"
    },
    "vet_phone": {
      "type": "string"
    },
    "vet_clinic_name": {
      "type": "string"
    },
    "vet_address": {
      "type": "string"
    },
    "medical_conditions": {
      "type": "string"
    },
    "medications": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "allergies": {
      "type": "string"
    },
    "medical_records": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "energy_level": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "very_high"
      ],
      "default": "normal"
    },
    "socialization": {
      "type": "string",
      "enum": [
        "friendly",
        "neutral",
        "shy",
        "aggressive"
      ],
      "default": "friendly"
    },
    "gets_along_with": {
      "type": "object",
      "properties": {
        "dogs": {
          "type": "boolean",
          "default": true
        },
        "cats": {
          "type": "boolean",
          "default": true
        },
        "children": {
          "type": "boolean",
          "default": true
        },
        "strangers": {
          "type": "boolean",
          "default": true
        }
      },
      "default": {}
    },
    "reactive_to_dogs": {
      "type": "boolean",
      "default": false,
      "description": "Reativo a outros c\u00e3es"
    },
    "reactive_to_people": {
      "type": "boolean",
      "default": false,
      "description": "Reativo a pessoas/estranhos"
    },
    "reactive_to_noises": {
      "type": "boolean",
      "default": false,
      "description": "Reativo a barulhos (trov\u00f5es, fogos, etc.)"
    },
    "behavioral_notes": {
      "type": "string"
    },
    "other_observations": {
      "type": "string",
      "description": "Outras observa\u00e7\u00f5es importantes para o passeador"
    },
    "favorite_toys": {
      "type": "string"
    },
    "favorite_treats": {
      "type": "string"
    },
    "special_care_notes": {
      "type": "string"
    },
    "habitat_requirements": {
      "type": "string"
    },
    "feeding_instructions": {
      "type": "string"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "emergency_contact_relationship": {
      "type": "string"
    },
    "insurance_provider": {
      "type": "string"
    },
    "insurance_policy_number": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "total_walks": {
      "type": "number",
      "default": 0
    },
    "total_training_sessions": {
      "type": "number",
      "default": 0
    },
    "gamification_level": {
      "type": "number",
      "default": 1
    },
    "gamification_stars": {
      "type": "number",
      "default": 0
    },
    "gamification_achievements": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "total_distance_km": {
      "type": "number",
      "default": 0
    },
    "perfect_walks_count": {
      "type": "number",
      "default": 0
    },
    "socialization_score": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "owner_email",
    "dog_name"
  ],
  "rls": {
    "create": {
      "data.owner_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}