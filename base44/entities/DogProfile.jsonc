{
  "name": "DogProfile",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string",
      "description": "Email do dono",
      "default": "{{user.email}}"
    },
    "owner_phone": {
      "type": "string",
      "description": "Telefone do dono (preenchimento autom\u00e1tico)"
    },
    "pickup_address": {
      "type": "string",
      "description": "Endere\u00e7o padr\u00e3o de recolha do animal"
    },
    "pickup_city": {
      "type": "string",
      "description": "Cidade de recolha"
    },
    "pickup_postal_code": {
      "type": "string",
      "description": "C\u00f3digo postal"
    },
    "pickup_latitude": {
      "type": "number",
      "description": "Latitude do endere\u00e7o de recolha"
    },
    "pickup_longitude": {
      "type": "number",
      "description": "Longitude do endere\u00e7o de recolha"
    },
    "animal_type": {
      "type": "string",
      "enum": [
        "dog",
        "cat",
        "reptile",
        "arachnid",
        "rodent",
        "bird"
      ],
      "default": "dog",
      "description": "Tipo de animal"
    },
    "dog_name": {
      "type": "string",
      "description": "Nome do pet"
    },
    "photo_url": {
      "type": "string",
      "description": "Foto principal do pet"
    },
    "gallery_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Galeria de fotos",
      "default": []
    },
    "breed": {
      "type": "string",
      "description": "Ra\u00e7a ou esp\u00e9cie"
    },
    "age": {
      "type": "number",
      "description": "Idade em anos"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Data de nascimento"
    },
    "weight": {
      "type": "number",
      "description": "Peso em kg"
    },
    "size": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large",
        "extra_large"
      ],
      "description": "Tamanho"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ],
      "description": "Sexo"
    },
    "color": {
      "type": "string",
      "description": "Cor"
    },
    "is_adopted": {
      "type": "boolean",
      "default": false,
      "description": "Se foi adotado"
    },
    "adoption_date": {
      "type": "string",
      "format": "date",
      "description": "Data de ado\u00e7\u00e3o"
    },
    "adoption_story": {
      "type": "string",
      "description": "Hist\u00f3ria de ado\u00e7\u00e3o"
    },
    "microchip_number": {
      "type": "string",
      "description": "N\u00famero do microchip"
    },
    "is_neutered": {
      "type": "boolean",
      "default": false
    },
    "is_vaccinated": {
      "type": "boolean",
      "default": true
    },
    "vaccination_date": {
      "type": "string",
      "format": "date"
    },
    "vaccination_records": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "vet_name": {
      "type": "string"
    },
    "vet_phone": {
      "type": "string"
    },
    "vet_clinic_name": {
      "type": "string",
      "description": "Nome da cl\u00ednica veterin\u00e1ria"
    },
    "vet_address": {
      "type": "string",
      "description": "Endere\u00e7o da cl\u00ednica"
    },
    "medical_conditions": {
      "type": "string"
    },
    "medications": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "allergies": {
      "type": "string"
    },
    "medical_records": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "energy_level": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "very_high"
      ],
      "default": "normal"
    },
    "socialization": {
      "type": "string",
      "enum": [
        "friendly",
        "neutral",
        "shy",
        "aggressive"
      ],
      "default": "friendly"
    },
    "gets_along_with": {
      "type": "object",
      "properties": {
        "dogs": {
          "type": "boolean",
          "default": true
        },
        "cats": {
          "type": "boolean",
          "default": true
        },
        "children": {
          "type": "boolean",
          "default": true
        },
        "strangers": {
          "type": "boolean",
          "default": true
        }
      },
      "default": {}
    },
    "behavioral_notes": {
      "type": "string"
    },
    "favorite_toys": {
      "type": "string"
    },
    "favorite_treats": {
      "type": "string",
      "description": "Petiscos favoritos"
    },
    "special_care_notes": {
      "type": "string",
      "description": "Notas especiais de cuidado"
    },
    "habitat_requirements": {
      "type": "string",
      "description": "Requisitos de habitat (terr\u00e1rio, gaiola, etc.)"
    },
    "feeding_instructions": {
      "type": "string",
      "description": "Instru\u00e7\u00f5es de alimenta\u00e7\u00e3o"
    },
    "emergency_contact_name": {
      "type": "string",
      "description": "Nome do contato de emerg\u00eancia"
    },
    "emergency_contact_phone": {
      "type": "string",
      "description": "Telefone do contato de emerg\u00eancia"
    },
    "emergency_contact_relationship": {
      "type": "string",
      "description": "Rela\u00e7\u00e3o com o contato de emerg\u00eancia"
    },
    "insurance_provider": {
      "type": "string",
      "description": "Nome da seguradora"
    },
    "insurance_policy_number": {
      "type": "string",
      "description": "N\u00famero da ap\u00f3lice de seguro"
    },
    "bio": {
      "type": "string",
      "description": "Biografia do pet"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "total_walks": {
      "type": "number",
      "default": 0,
      "description": "Total de passeios realizados"
    },
    "total_training_sessions": {
      "type": "number",
      "default": 0,
      "description": "Total de sess\u00f5es de treino"
    },
    "gamification_level": {
      "type": "number",
      "default": 1,
      "description": "N\u00edvel de gamifica\u00e7\u00e3o (1-10)"
    },
    "gamification_stars": {
      "type": "number",
      "default": 0,
      "description": "Estrelas conquistadas (0-5)"
    },
    "gamification_achievements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "achievement_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "milestone",
              "behavior",
              "social",
              "special"
            ]
          },
          "earned_date": {
            "type": "string",
            "format": "date-time"
          },
          "rarity": {
            "type": "string",
            "enum": [
              "common",
              "rare",
              "epic",
              "legendary"
            ]
          }
        }
      },
      "default": [],
      "description": "Conquistas desbloqueadas"
    },
    "total_distance_km": {
      "type": "number",
      "default": 0,
      "description": "Dist\u00e2ncia total percorrida em passeios (km)"
    },
    "perfect_walks_count": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero de passeios perfeitos (5 estrelas)"
    },
    "socialization_score": {
      "type": "number",
      "default": 0,
      "description": "Pontua\u00e7\u00e3o de socializa\u00e7\u00e3o"
    }
  },
  "required": [
    "owner_email",
    "dog_name"
  ],
  "rls": {
    "create": {
      "data.owner_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_email": {
            "$in": {
              "entities": "Booking",
              "query": {
                "walker_email": "{{user.email}}"
              },
              "field": "owner_email"
            }
          }
        },
        {
          "data.owner_email": {
            "$in": {
              "entities": "TrainingBooking",
              "query": {
                "trainer_email": "{{user.email}}"
              },
              "field": "owner_email"
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}