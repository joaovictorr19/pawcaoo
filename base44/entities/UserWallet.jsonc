{
  "name": "UserWallet",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do utilizador"
    },
    "cashback_balance": {
      "type": "number",
      "default": 0,
      "description": "Saldo de cashback em euros (N\u00c3O SAC\u00c1VEL - s\u00f3 uso interno na loja PawC\u00e3o)"
    },
    "service_tokens": {
      "type": "number",
      "default": 0,
      "description": "Tokens de passeio dispon\u00edveis"
    },
    "tokens_used_this_month": {
      "type": "number",
      "default": 0,
      "description": "Tokens usados no ciclo atual"
    },
    "total_points": {
      "type": "number",
      "default": 0,
      "description": "Total de pontos acumulados (multiplicador por plano)"
    },
    "escrow_balance": {
      "type": "number",
      "default": 0,
      "description": "COFRE DE RESERVA - Valor cativo para pagar walkers (\u20ac12-15 por token)"
    },
    "pending_walker_payments": {
      "type": "number",
      "default": 0,
      "description": "Pagamentos pendentes a walkers (tokens usados aguardando transfer\u00eancia)"
    },
    "tokens_expiry_date": {
      "type": "string",
      "format": "date",
      "description": "Data de expira\u00e7\u00e3o dos tokens (fim do ciclo mensal)"
    },
    "last_renewal_date": {
      "type": "string",
      "format": "date",
      "description": "Data da \u00faltima renova\u00e7\u00e3o"
    },
    "cycle_start_date": {
      "type": "string",
      "format": "date",
      "description": "In\u00edcio do ciclo atual"
    },
    "total_breakage_generated": {
      "type": "number",
      "default": 0,
      "description": "Total de breakage gerado (tokens n\u00e3o usados convertidos em lucro)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}