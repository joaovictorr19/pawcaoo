{
  "name": "CompanyVault",
  "type": "object",
  "properties": {
    "transaction_type": {
      "type": "string",
      "enum": [
        "deposit",
        "withdrawal",
        "gift_credit",
        "gift_debit",
        "adjustment",
        "commission",
        "breakage",
        "subscription",
        "shop_margin"
      ],
      "description": "Tipo de transa\u00e7\u00e3o do cofre"
    },
    "amount": {
      "type": "number",
      "description": "Valor da transa\u00e7\u00e3o em euros (positivo = entra no cofre, negativo = sai)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da transa\u00e7\u00e3o"
    },
    "category": {
      "type": "string",
      "enum": [
        "commission",
        "subscription",
        "shop",
        "gift",
        "adjustment",
        "breakage",
        "refund",
        "operational"
      ],
      "description": "Categoria da transa\u00e7\u00e3o"
    },
    "recipient_email": {
      "type": "string",
      "description": "Email do destinat\u00e1rio (para ofertas/cr\u00e9ditos)"
    },
    "recipient_name": {
      "type": "string",
      "description": "Nome do destinat\u00e1rio"
    },
    "source_reference": {
      "type": "string",
      "description": "Refer\u00eancia externa (booking_id, order_id, etc)"
    },
    "balance_after": {
      "type": "number",
      "description": "Saldo do cofre ap\u00f3s esta transa\u00e7\u00e3o"
    },
    "created_by_admin": {
      "type": "string",
      "description": "Email do admin que registou a transa\u00e7\u00e3o"
    }
  },
  "required": [
    "transaction_type",
    "amount",
    "description"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}