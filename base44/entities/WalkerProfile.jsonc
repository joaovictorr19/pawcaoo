{
  "name": "WalkerProfile",
  "type": "object",
  "properties": {
    "professional_type": {
      "type": "string",
      "enum": [
        "walker",
        "trainer",
        "both",
        "hotel"
      ],
      "default": "walker",
      "description": "Tipo de profissional"
    },
    "user_id": {
      "type": "string",
      "description": "Auth User ID linked to this profile"
    },
    "walker_name": {
      "type": "string",
      "description": "Name of the dog walker / hotel name"
    },
    "age": {
      "type": "number"
    },
    "photo_url": {
      "type": "string"
    },
    "cover_photo_url": {
      "type": "string"
    },
    "video_intro_url": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "service_areas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "area_name": {
            "type": "string"
          },
          "postal_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "radius_km": {
            "type": "number"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "hourly_rate": {
      "type": "number"
    },
    "exotic_rate": {
      "type": "number"
    },
    "services_offered": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "service_name": {
            "type": "string"
          },
          "icon": {
            "type": "string",
            "description": "Icon name from ServiceIconPicker"
          },
          "service_type": {
            "type": "string",
            "enum": [
              "walk",
              "training",
              "boarding",
              "daycare",
              "grooming",
              "dropin",
              "other"
            ]
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "price_per_day": {
            "type": "number"
          },
          "duration_options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "custom_pricing": {
            "type": "boolean"
          },
          "is_active": {
            "type": "boolean",
            "default": true
          },
          "accepted_dog_sizes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "small",
                "medium",
                "large",
                "extra_large"
              ]
            }
          }
        }
      },
      "default": []
    },
    "experience_years": {
      "type": "number"
    },
    "dog_sizes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "small",
          "medium",
          "large",
          "extra_large"
        ]
      },
      "default": []
    },
    "dog_breeds_handled": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "breed_specialization": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "accepted_animals": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "dogs",
          "cats",
          "reptiles",
          "arachnids",
          "rodents",
          "birds"
        ]
      },
      "default": [
        "dogs"
      ]
    },
    "availability": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "morning",
          "afternoon",
          "evening",
          "night"
        ]
      },
      "default": []
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "total_walks": {
      "type": "number",
      "default": 0
    },
    "phone": {
      "type": "string"
    },
    "whatsapp_number": {
      "type": "string"
    },
    "mbway_number": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_online": {
      "type": "boolean",
      "default": false
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "is_pawcao_employee": {
      "type": "boolean",
      "default": false
    },
    "has_pawcao_seal": {
      "type": "boolean",
      "default": false
    },
    "exempt_from_platform_fees": {
      "type": "boolean",
      "default": false
    },
    "commission_rate_mode": {
      "type": "string",
      "enum": [
        "default",
        "custom_percent",
        "zero",
        "zero_temporary"
      ],
      "default": "default",
      "description": "Modo de taxa: default=padrao plataforma, custom_percent=percentual personalizado, zero=isento permanente, zero_temporary=isento ate data de expiracao"
    },
    "custom_commission_rate": {
      "type": "number",
      "description": "Percentual personalizado de comissao (ex: 5 = 5%). Usado quando commission_rate_mode=custom_percent"
    },
    "commission_rate_expiry": {
      "type": "string",
      "format": "date",
      "description": "Data de expiracao da taxa zero temporaria. Quando expira, reverte para o padrao da plataforma"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_verified_trainer": {
      "type": "boolean",
      "default": false
    },
    "training_specializations": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "training_specialties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "training_philosophy": {
      "type": "string"
    },
    "consultation_options": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "in_person",
          "online",
          "hybrid"
        ]
      },
      "default": []
    },
    "can_walk_multiple_dogs": {
      "type": "boolean",
      "default": false
    },
    "max_dogs_at_once": {
      "type": "number",
      "default": 1
    },
    "portfolio": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "hotel_partnerships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hotel_profile_id": {
            "type": "string"
          },
          "hotel_name": {
            "type": "string"
          },
          "hotel_photo_url": {
            "type": "string"
          },
          "partner_role": {
            "type": "string",
            "enum": [
              "simple",
              "limited",
              "full"
            ],
            "default": "simple"
          }
        }
      },
      "default": [],
      "description": "Hoteis onde este profissional e parceiro/colaborador"
    },
    "faq": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "success_stories": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "certifications_detailed": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "specializations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "puppies",
          "senior_dogs",
          "special_needs",
          "behavioral_issues",
          "multiple_dogs",
          "large_breeds",
          "small_breeds",
          "anxious_dogs",
          "high_energy"
        ]
      },
      "default": []
    },
    "languages_spoken": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "requires_documents",
        "pending",
        "verified",
        "rejected"
      ],
      "default": "requires_documents"
    },
    "total_earnings": {
      "type": "number",
      "default": 0
    },
    "id_document_url": {
      "type": "string"
    },
    "proof_of_address_url": {
      "type": "string"
    },
    "bank_account_holder": {
      "type": "string"
    },
    "bank_account_number": {
      "type": "string"
    },
    "bank_routing_number": {
      "type": "string"
    },
    "instant_booking": {
      "type": "boolean",
      "default": false
    },
    "stripe_account_id": {
      "type": "string"
    },
    "stripe_charges_enabled": {
      "type": "boolean",
      "default": false
    },
    "stripe_payouts_enabled": {
      "type": "boolean",
      "default": false
    },
    "stripe_onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "country_of_operation": {
      "type": "string",
      "enum": [
        "portugal",
        "spain",
        "france"
      ]
    },
    "tax_id_portugal": {
      "type": "string"
    },
    "tax_id_spain": {
      "type": "string"
    },
    "france_professional_type": {
      "type": "string",
      "enum": [
        "professional",
        "individual"
      ]
    },
    "tax_id_france": {
      "type": "string"
    },
    "hotel_details": {
      "type": "object",
      "description": "Campos especificos para perfis de hotel canino",
      "properties": {
        "hotel_name": {
          "type": "string"
        },
        "hotel_description": {
          "type": "string"
        },
        "full_address": {
          "type": "string"
        },
        "capacity_total": {
          "type": "number",
          "description": "Capacidade maxima de caes simultaneos"
        },
        "capacity_available": {
          "type": "number",
          "description": "Vagas disponiveis hoje"
        },
        "price_per_night": {
          "type": "number"
        },
        "price_daycare": {
          "type": "number",
          "description": "Preco por dia de creche"
        },
        "checkin_time": {
          "type": "string"
        },
        "checkout_time": {
          "type": "string"
        },
        "hide_checkin_times": {
          "type": "boolean",
          "default": false,
          "description": "Ocultar horarios de check-in/out no perfil publico"
        },
        "checkin_description": {
          "type": "string",
          "description": "Descricao exibida abaixo dos horarios de check-in/out"
        },
        "checkin_policy_type": {
          "type": "string",
          "enum": [
            "all_days",
            "no_sundays",
            "no_sundays_holidays"
          ],
          "default": "all_days",
          "description": "Politica de check-in/out: all_days, no_sundays, no_sundays_holidays"
        },
        "blocked_dates": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "date"
          },
          "default": [],
          "description": "Datas bloqueadas pelo hotel (folgas) - nao aceita reservas nestes dias"
        },
        "amenities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Comodidades: piscina, jardim, webcam, etc"
        },
        "accepted_dog_sizes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "small",
              "medium",
              "large",
              "extra_large"
            ]
          }
        },
        "partner_walkers": {
          "type": "array",
          "description": "Passeadores parceiros do hotel",
          "items": {
            "type": "object",
            "properties": {
              "walker_email": {
                "type": "string"
              },
              "walker_name": {
                "type": "string"
              },
              "walker_photo_url": {
                "type": "string"
              },
              "walker_profile_id": {
                "type": "string"
              },
              "partner_role": {
                "type": "string",
                "enum": [
                  "simple",
                  "limited",
                  "full"
                ],
                "default": "simple"
              },
              "is_available_today": {
                "type": "boolean",
                "default": false
              },
              "services": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "default": []
        },
        "weekly_schedule": {
          "type": "object",
          "description": "Horarios por dia da semana",
          "properties": {
            "monday": {
              "type": "object",
              "properties": {
                "open": {
                  "type": "boolean"
                },
                "open_time": {
                  "type": "string"
                },
                "close_time": {
                  "type": "string"
                }
              }
            },
            "tuesday": {
              "type": "object",
              "properties": {
                "open": {
                  "type": "boolean"
                },
                "open_time": {
                  "type": "string"
                },
                "close_time": {
                  "type": "string"
                }
              }
            },
            "wednesday": {
              "type": "object",
              "properties": {
                "open": {
                  "type": "boolean"
                },
                "open_time": {
                  "type": "string"
                },
                "close_time": {
                  "type": "string"
                }
              }
            },
            "thursday": {
              "type": "object",
              "properties": {
                "open": {
                  "type": "boolean"
                },
                "open_time": {
                  "type": "string"
                },
                "close_time": {
                  "type": "string"
                }
              }
            },
            "friday": {
              "type": "object",
              "properties": {
                "open": {
                  "type": "boolean"
                },
                "open_time": {
                  "type": "string"
                },
                "close_time": {
                  "type": "string"
                }
              }
            },
            "saturday": {
              "type": "object",
              "properties": {
                "open": {
                  "type": "boolean"
                },
                "open_time": {
                  "type": "string"
                },
                "close_time": {
                  "type": "string"
                }
              }
            },
            "sunday": {
              "type": "object",
              "properties": {
                "open": {
                  "type": "boolean"
                },
                "open_time": {
                  "type": "string"
                },
                "close_time": {
                  "type": "string"
                }
              }
            }
          }
        },
        "services": {
          "type": "array",
          "description": "Servicos oferecidos pelo hotel com capacidades individuais",
          "items": {
            "type": "object",
            "properties": {
              "service_id": {
                "type": "string",
                "description": "ID unico do servico"
              },
              "service_name": {
                "type": "string",
                "description": "Nome do servico"
              },
              "service_type": {
                "type": "string",
                "enum": [
                  "daycare",
                  "boarding",
                  "grooming",
                  "training",
                  "other"
                ],
                "description": "Tipo de servico"
              },
              "capacity_total": {
                "type": "number",
                "description": "Capacidade maxima para este servico"
              },
              "capacity_available": {
                "type": "number",
                "description": "Vagas disponiveis hoje para este servico"
              },
              "price_per_day": {
                "type": "number",
                "description": "Preco por dia/noite"
              },
              "is_active": {
                "type": "boolean",
                "default": true,
                "description": "Se o servico esta ativo"
              },
              "description": {
                "type": "string"
              },
              "accepted_dog_sizes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "small",
                    "medium",
                    "large",
                    "extra_large"
                  ]
                },
                "default": []
              }
            },
            "required": [
              "service_id",
              "service_name",
              "service_type",
              "capacity_total"
            ]
          },
          "default": []
        }
      }
    }
  },
  "required": [
    "walker_name",
    "location"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}