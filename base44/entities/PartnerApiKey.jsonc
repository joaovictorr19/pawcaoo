{
  "name": "PartnerApiKey",
  "type": "object",
  "properties": {
    "partner_id": {
      "type": "string",
      "description": "ID do parceiro (Partnership)"
    },
    "partner_name": {
      "type": "string",
      "description": "Nome do parceiro"
    },
    "api_key": {
      "type": "string",
      "description": "Chave de API \u00fanica"
    },
    "api_secret_hash": {
      "type": "string",
      "description": "Hash do secret da API"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "products:read",
          "products:write",
          "services:read",
          "services:write",
          "orders:read",
          "orders:write",
          "bookings:read",
          "bookings:write"
        ]
      },
      "default": [
        "products:read",
        "services:read",
        "orders:read"
      ],
      "description": "Permiss\u00f5es da API key"
    },
    "rate_limit_per_minute": {
      "type": "number",
      "default": 60,
      "description": "Limite de requisi\u00e7\u00f5es por minuto"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_count": {
      "type": "number",
      "default": 0
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data de expira\u00e7\u00e3o (opcional)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description"
    }
  },
  "required": [
    "partner_id",
    "api_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}