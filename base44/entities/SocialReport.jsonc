{
  "name": "SocialReport",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string"
    },
    "reporter_email": {
      "type": "string"
    },
    "reporter_name": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewing",
        "resolved",
        "dismissed"
      ],
      "default": "pending"
    },
    "moderation_action": {
      "type": "string"
    },
    "moderation_notes": {
      "type": "string"
    },
    "moderated_by": {
      "type": "string"
    },
    "resolved_date": {
      "type": "string"
    }
  },
  "required": [
    "post_id",
    "reporter_email",
    "reason"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}