{
  "name": "HotelBooking",
  "type": "object",
  "properties": {
    "hotel_profile_id": {
      "type": "string",
      "description": "ID do WalkerProfile do hotel"
    },
    "hotel_name": {
      "type": "string"
    },
    "hotel_email": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "owner_phone": {
      "type": "string"
    },
    "emergency_contact_name": {
      "type": "string",
      "description": "Contacto de emergencia (alternativo ao dono)"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "veterinarian_name": {
      "type": "string",
      "description": "Veterinario habitual do animal"
    },
    "veterinarian_phone": {
      "type": "string"
    },
    "dogs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dog_name": {
            "type": "string"
          },
          "dog_breed": {
            "type": "string"
          },
          "dog_size": {
            "type": "string",
            "enum": [
              "small",
              "medium",
              "large",
              "extra_large"
            ]
          },
          "dog_age": {
            "type": "number"
          },
          "special_notes": {
            "type": "string"
          },
          "diet": {
            "type": "string",
            "description": "Dieta e alimentacao do animal"
          },
          "medications": {
            "type": "string",
            "description": "Medicamentos, dosagem, frequencia e horarios"
          },
          "routine": {
            "type": "string",
            "description": "Rotina diaria do animal"
          },
          "vaccine_expiry": {
            "type": "string",
            "format": "date",
            "description": "Data de validade da vacina da raiva"
          },
          "vaccine_document_url": {
            "type": "string",
            "description": "Comprovativo de vacinacao (PDF/imagem)"
          },
          "vaccine_verified": {
            "type": "boolean",
            "default": false,
            "description": "Vacina verificada pelo hotel"
          }
        }
      },
      "default": []
    },
    "service_type": {
      "type": "string",
      "enum": [
        "boarding",
        "daycare",
        "grooming",
        "walk_with_partner",
        "training"
      ],
      "description": "Tipo de servico reservado"
    },
    "checkin_date": {
      "type": "string",
      "format": "date"
    },
    "checkout_date": {
      "type": "string",
      "format": "date"
    },
    "checkin_time": {
      "type": "string"
    },
    "checkout_time": {
      "type": "string"
    },
    "total_nights": {
      "type": "number",
      "default": 1
    },
    "total_dogs": {
      "type": "number",
      "default": 1
    },
    "price_per_night": {
      "type": "number"
    },
    "add_ons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "service_name": {
            "type": "string",
            "enum": [
              "walk",
              "training",
              "grooming",
              "bathing",
              "nail_trim",
              "feeding",
              "medication",
              "playtime",
              "general_care"
            ]
          },
          "quantity": {
            "type": "number",
            "description": "Numero de sessoes/passeios"
          },
          "price_per_unit": {
            "type": "number"
          },
          "total_price": {
            "type": "number"
          },
          "assigned_walker_email": {
            "type": "string",
            "description": "Email do parceiro responsavel"
          },
          "assigned_walker_name": {
            "type": "string"
          },
          "completed": {
            "type": "boolean",
            "default": false,
            "description": "Se a tarefa foi concluida"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "description": "Quando a tarefa foi concluida"
          },
          "task_notes": {
            "type": "string",
            "description": "Notas do parceiro ao concluir a tarefa"
          },
          "assignment_notes": {
            "type": "string",
            "description": "Instrucoes deixadas pelo hotel ao atribuir a tarefa"
          },
          "due_time": {
            "type": "string",
            "description": "Horario recomendado para executar a tarefa (HH:MM)"
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "description": "Data recomendada para executar a tarefa"
          }
        }
      },
      "default": [],
      "description": "Servicos adicionais durante a estadia"
    },
    "add_ons_total": {
      "type": "number",
      "default": 0
    },
    "total_amount": {
      "type": "number"
    },
    "platform_fee": {
      "type": "number"
    },
    "service_amount": {
      "type": "number"
    },
    "special_requests": {
      "type": "string"
    },
    "assigned_walker_email": {
      "type": "string"
    },
    "assigned_walker_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "checked_in",
        "in_progress",
        "checked_out",
        "completed",
        "cancelled",
        "rejected"
      ],
      "default": "pending"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "refunded",
        "partial"
      ],
      "default": "pending"
    },
    "stripe_payment_intent_id": {
      "type": "string"
    },
    "payment_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora limite para pagamento (5 min apos criacao). Se nao pago, reserva e cancelada automaticamente."
    },
    "internal_notes": {
      "type": "string"
    },
    "behavioral_notes": {
      "type": "string",
      "description": "Notas comportamentais do animal durante a estadia"
    },
    "checkin_photo_url": {
      "type": "string"
    },
    "checkout_photo_url": {
      "type": "string"
    },
    "daily_report_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "cancellation_reason": {
      "type": "string"
    },
    "review_id": {
      "type": "string"
    },
    "checkin_checklist": {
      "type": "array",
      "description": "Checklist de verificacao de cuidados no check-in",
      "items": {
        "type": "object",
        "properties": {
          "dog_name": {
            "type": "string"
          },
          "diet_verified": {
            "type": "boolean",
            "default": false
          },
          "medications_verified": {
            "type": "boolean",
            "default": false
          },
          "routine_verified": {
            "type": "boolean",
            "default": false
          },
          "verified_at": {
            "type": "string",
            "format": "date-time"
          },
          "verified_by": {
            "type": "string"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "hotel_profile_id",
    "owner_name",
    "owner_email",
    "service_type",
    "checkin_date",
    "total_amount"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.hotel_email": "{{user.email}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "data.assigned_walker_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.hotel_email": "{{user.email}}"
        },
        {
          "data.assigned_walker_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}