{
  "name": "UserReport",
  "type": "object",
  "properties": {
    "reporter_email": {
      "type": "string",
      "description": "Email de quem denuncia"
    },
    "reporter_name": {
      "type": "string"
    },
    "reported_user_email": {
      "type": "string",
      "description": "Email do utilizador denunciado"
    },
    "reported_user_name": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "inappropriate_content",
        "fake_profile",
        "harassment",
        "spam",
        "animal_safety",
        "other"
      ],
      "description": "Motivo da den\u00fancia"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada da den\u00fancia"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewing",
        "resolved",
        "dismissed"
      ],
      "default": "pending"
    },
    "admin_notes": {
      "type": "string"
    }
  },
  "required": [
    "reporter_email",
    "reported_user_email",
    "reason"
  ],
  "rls": {
    "create": {
      "data.reporter_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.reporter_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}