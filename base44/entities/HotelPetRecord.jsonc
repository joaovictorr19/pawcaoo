{
  "name": "HotelPetRecord",
  "type": "object",
  "properties": {
    "hotel_profile_id": {
      "type": "string",
      "description": "ID do WalkerProfile do hotel"
    },
    "hotel_email": {
      "type": "string"
    },
    "booking_id": {
      "type": "string",
      "description": "ID da reserva associada"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "dog_name": {
      "type": "string",
      "description": "Nome do animal"
    },
    "dog_breed": {
      "type": "string"
    },
    "dog_size": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large",
        "extra_large"
      ]
    },
    "record_type": {
      "type": "string",
      "enum": [
        "health",
        "behavior",
        "feeding",
        "medication",
        "incident",
        "observation",
        "elimination",
        "exercise",
        "grooming",
        "veterinary"
      ],
      "description": "Tipo de registo: saude, comportamento, alimentacao, medicamento, incidente, observacao, eliminacao, exercicio, grooming, veterinario"
    },
    "title": {
      "type": "string",
      "description": "Titulo curto do registo"
    },
    "description": {
      "type": "string",
      "description": "Descricao detalhada"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "low",
      "description": "Gravidade (para saude/incidentes)"
    },
    "temperature": {
      "type": "number",
      "description": "Temperatura corporal (\u00b0C) se aplicavel"
    },
    "weight_kg": {
      "type": "number",
      "description": "Peso registado (kg)"
    },
    "appetite": {
      "type": "string",
      "enum": [
        "normal",
        "reduced",
        "none",
        "increased"
      ],
      "description": "Apetite observado"
    },
    "energy_level": {
      "type": "string",
      "enum": [
        "normal",
        "lethargic",
        "hyperactive",
        "calm"
      ],
      "description": "Nivel de energia observado"
    },
    "stool_status": {
      "type": "string",
      "enum": [
        "normal",
        "loose",
        "constipated",
        "none",
        "blood"
      ],
      "description": "Estado das fezes"
    },
    "urination": {
      "type": "string",
      "enum": [
        "normal",
        "frequent",
        "reduced",
        "none",
        "accident"
      ],
      "description": "Padrao de miccao"
    },
    "water_intake": {
      "type": "string",
      "enum": [
        "normal",
        "reduced",
        "excessive",
        "none"
      ],
      "description": "Ingestao de agua"
    },
    "socialization": {
      "type": "string",
      "enum": [
        "friendly",
        "neutral",
        "shy",
        "aggressive",
        "anxious"
      ],
      "description": "Comportamento social com outros caes/pessoas"
    },
    "mood": {
      "type": "string",
      "enum": [
        "happy",
        "calm",
        "excited",
        "anxious",
        "tired",
        "stressed",
        "depressed"
      ],
      "description": "Humor/estado emocional observado"
    },
    "exercise_minutes": {
      "type": "number",
      "description": "Minutos de exercicio/passeio"
    },
    "exercise_type": {
      "type": "string",
      "enum": [
        "walk",
        "playtime",
        "training",
        "swimming",
        "none"
      ],
      "description": "Tipo de exercicio realizado"
    },
    "sleep_hours": {
      "type": "number",
      "description": "Horas de sono descansado"
    },
    "photo_url": {
      "type": "string",
      "description": "Foto anexada ao registo"
    },
    "grooming_notes": {
      "type": "string",
      "description": "Notas de grooming/banho"
    },
    "vaccination_checked": {
      "type": "boolean",
      "default": false,
      "description": "Vacina verificada nesta data"
    },
    "deworming_date": {
      "type": "string",
      "format": "date",
      "description": "Data da ultima desparasitacao"
    },
    "flea_tick_treatment": {
      "type": "boolean",
      "default": false,
      "description": "Tratamento pulgas/carrapatos aplicado"
    },
    "recorded_by": {
      "type": "string",
      "description": "Email do membro da equipa que registou"
    },
    "recorded_by_name": {
      "type": "string"
    },
    "follow_up_needed": {
      "type": "boolean",
      "default": false,
      "description": "Necessita acompanhamento"
    },
    "follow_up_notes": {
      "type": "string",
      "description": "Notas de acompanhamento"
    },
    "follow_up_resolved": {
      "type": "boolean",
      "default": false,
      "description": "Acompanhamento resolvido"
    },
    "notify_owner": {
      "type": "boolean",
      "default": false,
      "description": "Se este registo deve ser notificado ao dono no site"
    }
  },
  "required": [
    "hotel_profile_id",
    "dog_name",
    "record_type",
    "title",
    "description"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.hotel_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.hotel_email": "{{user.email}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.hotel_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.hotel_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}