{
  "name": "ProfileEditRequest",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string",
      "description": "ID do perfil (WalkerProfile ou TrainerProfile)"
    },
    "profile_type": {
      "type": "string",
      "enum": [
        "walker",
        "trainer",
        "hotel"
      ],
      "description": "Tipo de perfil profissional"
    },
    "professional_name": {
      "type": "string",
      "description": "Nome do profissional"
    },
    "professional_email": {
      "type": "string",
      "description": "Email do profissional"
    },
    "requested_changes": {
      "type": "object",
      "description": "Objeto JSON contendo os campos alterados (ex: services_offered, pricing)"
    },
    "original_data": {
      "type": "object",
      "description": "Dados originais para compara\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Estado da solicitacao"
    },
    "admin_notes": {
      "type": "string",
      "description": "Notas do administrador"
    }
  },
  "required": [
    "profile_id",
    "profile_type",
    "requested_changes"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}