{
  "name": "MonthlyPodiumPrize",
  "type": "object",
  "properties": {
    "month_key": {
      "type": "string",
      "description": "M\u00eas a que os pr\u00e9mios pertencem, no formato AAAA-MM (fuso Europe/Lisbon)"
    },
    "month_label": {
      "type": "string",
      "description": "Nome leg\u00edvel do m\u00eas (ex: Novembro 2026)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se desativado, os p\u00f3dios n\u00e3o apresentam pr\u00e9mios neste m\u00eas"
    },
    "hotel_prizes": {
      "type": "array",
      "description": "Pr\u00e9mios dos tr\u00eas lugares do p\u00f3dio de hot\u00e9is",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "position": {
            "type": "number",
            "description": "Lugar no p\u00f3dio (1 a 3)"
          },
          "title": {
            "type": "string",
            "description": "Nome do pr\u00e9mio"
          },
          "description": {
            "type": "string",
            "description": "Descri\u00e7\u00e3o curta do pr\u00e9mio"
          },
          "image_url": {
            "type": "string",
            "description": "Imagem do pr\u00e9mio"
          }
        }
      }
    },
    "walker_prizes": {
      "type": "array",
      "description": "Pr\u00e9mios dos tr\u00eas lugares do p\u00f3dio de passeadores",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "position": {
            "type": "number",
            "description": "Lugar no p\u00f3dio (1 a 3)"
          },
          "title": {
            "type": "string",
            "description": "Nome do pr\u00e9mio"
          },
          "description": {
            "type": "string",
            "description": "Descri\u00e7\u00e3o curta do pr\u00e9mio"
          },
          "image_url": {
            "type": "string",
            "description": "Imagem do pr\u00e9mio"
          }
        }
      }
    }
  },
  "required": [
    "month_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}