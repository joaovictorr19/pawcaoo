{
  "name": "Payment",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string",
      "description": "ID of the related booking"
    },
    "emergency_walk_id": {
      "type": "string",
      "description": "ID of the emergency walk (if applicable)"
    },
    "payer_email": {
      "type": "string",
      "description": "Email of the person paying (dog owner)"
    },
    "payer_name": {
      "type": "string",
      "description": "Name of the person paying"
    },
    "recipient_email": {
      "type": "string",
      "description": "Email of the walker receiving payment"
    },
    "recipient_name": {
      "type": "string",
      "description": "Name of the walker"
    },
    "service_amount": {
      "type": "number",
      "description": "Amount for the service (what walker receives)"
    },
    "platform_fee": {
      "type": "number",
      "description": "Platform commission (your percentage)"
    },
    "transaction_fee": {
      "type": "number",
      "description": "Fixed transaction fee (e.g., \u20ac1)",
      "default": 1
    },
    "insurance_fee": {
      "type": "number",
      "description": "Optional insurance fee",
      "default": 0
    },
    "extra_services_fee": {
      "type": "number",
      "description": "Total from extra services",
      "default": 0
    },
    "total_amount": {
      "type": "number",
      "description": "Total amount paid by owner"
    },
    "platform_fee_percentage": {
      "type": "number",
      "description": "Percentage taken by platform",
      "default": 15
    },
    "walker_subscription_discount": {
      "type": "number",
      "description": "Discount from walker subscription",
      "default": 0
    },
    "loyalty_points_used": {
      "type": "number",
      "description": "Loyalty points redeemed",
      "default": 0
    },
    "loyalty_points_discount": {
      "type": "number",
      "description": "Discount from loyalty points",
      "default": 0
    },
    "refund_amount": {
      "type": "number",
      "description": "Amount refunded to customer",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "held",
        "released",
        "refunded",
        "failed"
      ],
      "default": "pending",
      "description": "Payment status"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "credit_card",
        "debit_card",
        "stripe",
        "paypal",
        "mbway"
      ],
      "description": "Payment method used"
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "description": "Stripe payment intent ID"
    },
    "stripe_transfer_id": {
      "type": "string",
      "description": "Stripe transfer ID to walker"
    },
    "paypal_order_id": {
      "type": "string",
      "description": "PayPal order ID"
    },
    "held_date": {
      "type": "string",
      "format": "date-time",
      "description": "When payment was received and held"
    },
    "released_date": {
      "type": "string",
      "format": "date-time",
      "description": "When payment was released to walker"
    },
    "split_details": {
      "type": "object",
      "properties": {
        "walker_receives": {
          "type": "number"
        },
        "platform_receives": {
          "type": "number"
        },
        "payment_processor_fee": {
          "type": "number"
        }
      },
      "description": "Detailed split breakdown"
    },
    "notes": {
      "type": "string",
      "description": "Any additional notes about the payment"
    }
  },
  "required": [
    "payer_email",
    "recipient_email",
    "service_amount",
    "total_amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.payer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.payer_email": "{{user.email}}"
        },
        {
          "data.recipient_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.payer_email": "{{user.email}}"
        },
        {
          "data.recipient_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}