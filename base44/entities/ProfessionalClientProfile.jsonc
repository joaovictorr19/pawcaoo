{
  "name": "ProfessionalClientProfile",
  "type": "object",
  "properties": {
    "professional_email": {
      "type": "string",
      "description": "Email do passeador/treinador"
    },
    "professional_name": {
      "type": "string"
    },
    "owner_email": {
      "type": "string",
      "description": "Email do dono do animal"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_phone": {
      "type": "string"
    },
    "owner_photo_url": {
      "type": "string"
    },
    "dogs": {
      "type": "array",
      "description": "C\u00e3es recorrentes deste cliente",
      "items": {
        "type": "object",
        "properties": {
          "dog_name": {
            "type": "string"
          },
          "dog_breed": {
            "type": "string"
          },
          "dog_size": {
            "type": "string",
            "enum": [
              "small",
              "medium",
              "large",
              "extra_large"
            ]
          },
          "dog_age": {
            "type": "number"
          },
          "photo_url": {
            "type": "string"
          },
          "behavioral_notes": {
            "type": "string",
            "description": "Notas comportamentais acumuladas pelo profissional"
          },
          "medical_notes": {
            "type": "string",
            "description": "Notas m\u00e9dicas persistentes (alergias, condi\u00e7\u00f5es)"
          }
        }
      },
      "default": []
    },
    "total_bookings": {
      "type": "number",
      "default": 0,
      "description": "Total de reservas realizadas"
    },
    "total_spent": {
      "type": "number",
      "default": 0,
      "description": "Total gasto em todos os servi\u00e7os"
    },
    "first_walk_date": {
      "type": "string",
      "format": "date"
    },
    "last_walk_date": {
      "type": "string",
      "format": "date"
    },
    "general_notes": {
      "type": "string",
      "description": "Notas gerais do cliente (prefer\u00eancias, alertas)"
    },
    "is_vip": {
      "type": "boolean",
      "default": false,
      "description": "Cliente VIP (frequente ou de valor)"
    },
    "counted_booking_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs das reservas j\u00e1 contabilizadas para evitar contagem duplicada"
    }
  },
  "required": [
    "professional_email",
    "owner_email",
    "owner_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.professional_email": "{{user.email}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.professional_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.professional_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}