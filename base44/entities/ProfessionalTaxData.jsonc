{
  "name": "ProfessionalTaxData",
  "type": "object",
  "properties": {
    "professional_email": {
      "type": "string",
      "description": "Email do profissional"
    },
    "professional_type": {
      "type": "string",
      "enum": [
        "walker",
        "trainer",
        "both",
        "hotel"
      ],
      "description": "Tipo de profissional"
    },
    "country": {
      "type": "string",
      "enum": [
        "PT",
        "ES",
        "FR",
        "DE",
        "IT",
        "UK",
        "OTHER"
      ],
      "default": "PT",
      "description": "Pa\u00eds de resid\u00eancia fiscal"
    },
    "tax_id": {
      "type": "string",
      "description": "NIF (PT), NIE (ES), SIRET (FR), etc."
    },
    "tax_id_type": {
      "type": "string",
      "enum": [
        "NIF",
        "NIE",
        "SIRET",
        "VAT",
        "OTHER"
      ],
      "description": "Tipo de identifica\u00e7\u00e3o fiscal"
    },
    "tax_id_verified": {
      "type": "boolean",
      "default": false,
      "description": "NIF verificado pelo admin"
    },
    "legal_name": {
      "type": "string",
      "description": "Nome legal completo (como aparece nos documentos)"
    },
    "fiscal_address": {
      "type": "string",
      "description": "Morada fiscal completa"
    },
    "fiscal_postal_code": {
      "type": "string",
      "description": "C\u00f3digo postal"
    },
    "fiscal_city": {
      "type": "string",
      "description": "Cidade"
    },
    "proof_of_address_url": {
      "type": "string",
      "description": "Comprovativo de morada (PDF/imagem)"
    },
    "is_vat_registered": {
      "type": "boolean",
      "default": false,
      "description": "Est\u00e1 registado para IVA/cobran\u00e7a de imposto"
    },
    "vat_rate": {
      "type": "number",
      "default": 0,
      "description": "Taxa de IVA aplic\u00e1vel (%)"
    },
    "vat_exemption_reason": {
      "type": "string",
      "description": "Motivo de isen\u00e7\u00e3o de IVA (ex: Art. 53\u00ba CIVA)"
    },
    "activity_code": {
      "type": "string",
      "description": "CAE/CNAE ou c\u00f3digo de atividade"
    },
    "invoicing_software": {
      "type": "string",
      "enum": [
        "manual",
        "moloni",
        "invoicexpress",
        "facturapi",
        "other"
      ],
      "default": "manual",
      "description": "Software de fatura\u00e7\u00e3o utilizado"
    },
    "invoicing_api_key": {
      "type": "string",
      "description": "Chave API do software de fatura\u00e7\u00e3o (encriptada)"
    },
    "bank_iban": {
      "type": "string",
      "description": "IBAN para recebimentos"
    },
    "bank_swift": {
      "type": "string",
      "description": "SWIFT/BIC"
    },
    "status": {
      "type": "string",
      "enum": [
        "incomplete",
        "pending_verification",
        "verified",
        "rejected"
      ],
      "default": "incomplete",
      "description": "Estado dos dados fiscais"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Motivo de rejei\u00e7\u00e3o (se aplic\u00e1vel)"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data de verifica\u00e7\u00e3o"
    },
    "verified_by": {
      "type": "string",
      "description": "Admin que verificou"
    }
  },
  "required": [
    "professional_email",
    "country"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.professional_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.professional_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}