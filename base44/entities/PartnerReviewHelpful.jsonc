{
  "name": "PartnerReviewHelpful",
  "type": "object",
  "properties": {
    "review_id": {
      "type": "string",
      "description": "ID of the review"
    },
    "user_email": {
      "type": "string",
      "description": "User who found it helpful",
      "rls": {
        "read": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "is_helpful": {
      "type": "boolean",
      "default": true,
      "description": "Whether they found it helpful"
    }
  },
  "required": [
    "review_id",
    "user_email"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {},
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}