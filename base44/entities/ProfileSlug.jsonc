{
  "name": "ProfileSlug",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "description": "URL slug \u00fanico (ex: hotel-canino-lisboa)"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "user",
        "walker",
        "trainer",
        "hotel",
        "company"
      ],
      "description": "Tipo de entidade"
    },
    "entity_id": {
      "type": "string",
      "description": "ID da entidade de destino"
    },
    "entity_email": {
      "type": "string",
      "description": "Email do utilizador/profissional"
    },
    "display_name": {
      "type": "string",
      "description": "Nome de exibi\u00e7\u00e3o"
    }
  },
  "required": [
    "slug",
    "entity_type"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}