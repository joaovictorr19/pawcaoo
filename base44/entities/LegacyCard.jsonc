{
  "name": "LegacyCard",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Dono da carta conquistada"
    },
    "card_id": {
      "type": "string",
      "description": "Identificador da prova\u00e7\u00e3o que originou a carta"
    },
    "card_title": {
      "type": "string",
      "description": "Nome da carta no momento da conquista"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "common",
        "rare",
        "epic",
        "legendary"
      ],
      "enumColors": [
        "gray",
        "blue",
        "purple",
        "yellow"
      ],
      "description": "Raridade da carta"
    },
    "points": {
      "type": "number",
      "default": 0,
      "description": "Valor da carta na cole\u00e7\u00e3o"
    },
    "xp_awarded": {
      "type": "number",
      "default": 0,
      "description": "XP atribu\u00eddo quando a carta foi conquistada"
    },
    "earned_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data da conquista"
    }
  },
  "required": [
    "user_email",
    "card_id"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}