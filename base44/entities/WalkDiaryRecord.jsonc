{
  "name": "WalkDiaryRecord",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string",
      "description": "ID da reserva (Booking) associada a este registo"
    },
    "walker_email": {
      "type": "string",
      "description": "Email do passeador/treinador que publicou o registo"
    },
    "walker_name": {
      "type": "string",
      "description": "Nome do profissional"
    },
    "owner_email": {
      "type": "string",
      "description": "Email do dono do animal"
    },
    "owner_name": {
      "type": "string"
    },
    "dog_name": {
      "type": "string",
      "description": "Nome do c\u00e3o"
    },
    "dog_breed": {
      "type": "string"
    },
    "dog_size": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large",
        "extra_large"
      ]
    },
    "photo_url": {
      "type": "string",
      "description": "Foto do passeio/sess\u00e3o"
    },
    "description": {
      "type": "string",
      "description": "Texto descritivo do passeio"
    },
    "exercise_minutes": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o do passeio em minutos"
    },
    "distance_km": {
      "type": "number",
      "description": "Dist\u00e2ncia percorrida em km"
    },
    "socialization": {
      "type": "string",
      "enum": [
        "friendly",
        "neutral",
        "shy",
        "aggressive"
      ],
      "description": "Comportamento social observado"
    },
    "mood": {
      "type": "string",
      "enum": [
        "happy",
        "calm",
        "excited",
        "anxious",
        "tired",
        "stressed"
      ],
      "description": "Humor/estado emocional observado"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "walk",
        "training"
      ],
      "default": "walk",
      "description": "Tipo de servi\u00e7o (passeio ou treino)"
    },
    "notify_owner": {
      "type": "boolean",
      "default": true,
      "description": "Se o dono deve ser notificado deste registo"
    }
  },
  "required": [
    "booking_id",
    "walker_email",
    "owner_email",
    "dog_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.walker_email": "{{user.email}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.walker_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.walker_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}