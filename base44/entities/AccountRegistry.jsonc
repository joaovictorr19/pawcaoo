{
  "name": "AccountRegistry",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email da conta (chave est\u00e1vel do registo)"
    },
    "user_id": {
      "type": "string",
      "description": "ID da conta de autentica\u00e7\u00e3o"
    },
    "display_name": {
      "type": "string",
      "description": "Nome de exibi\u00e7\u00e3o no momento da sincroniza\u00e7\u00e3o"
    },
    "auth_role": {
      "type": "string",
      "description": "Papel de autentica\u00e7\u00e3o (admin/user) \u2014 informativo, n\u00e3o \u00e9 permiss\u00e3o de regime"
    },
    "regime": {
      "type": "string",
      "enum": [
        "customer",
        "walker",
        "trainer",
        "hotel",
        "shop"
      ],
      "enumColors": [
        "gray",
        "green",
        "purple",
        "blue",
        "yellow"
      ],
      "description": "Regime DETETADO a partir dos perfis (Cliente/Passeador/Treinador/Hotel/Loja)"
    },
    "country": {
      "type": "string",
      "enum": [
        "portugal",
        "spain",
        "france"
      ],
      "enumColors": [
        "green",
        "yellow",
        "blue"
      ],
      "description": "Pa\u00eds DETETADO no perfil de opera\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "pending",
        "requires_documents",
        "rejected",
        "not_applicable"
      ],
      "enumColors": [
        "green",
        "yellow",
        "yellow",
        "red",
        "gray"
      ],
      "description": "Estado de verifica\u00e7\u00e3o consolidado"
    },
    "review_state": {
      "type": "string",
      "enum": [
        "ok",
        "missing_country",
        "missing_regime",
        "conflict",
        "no_profile"
      ],
      "enumColors": [
        "green",
        "yellow",
        "yellow",
        "red",
        "gray"
      ],
      "default": "ok",
      "description": "Problema detetado na origem (n\u00e3o \u00e9 apagado por decis\u00f5es manuais)"
    },
    "review_notes": {
      "type": "string",
      "description": "Detalhe leg\u00edvel do problema detetado"
    },
    "review_resolved": {
      "type": "boolean",
      "default": false,
      "description": "O admin j\u00e1 decidiu sobre este caso \u2014 a sincroniza\u00e7\u00e3o n\u00e3o volta a assinal\u00e1-lo"
    },
    "review_action": {
      "type": "string",
      "enum": [
        "confirmed",
        "claim_corrected",
        "onboarding_requested",
        "kept_in_review"
      ],
      "enumColors": [
        "green",
        "blue",
        "yellow",
        "gray"
      ],
      "description": "A\u00e7\u00e3o administrativa aplicada ao caso de revis\u00e3o"
    },
    "confirmed_regime": {
      "type": "string",
      "enum": [
        "customer",
        "walker",
        "trainer",
        "hotel",
        "shop"
      ],
      "enumColors": [
        "gray",
        "green",
        "purple",
        "blue",
        "yellow"
      ],
      "description": "Regime confirmado manualmente pelo admin (prevalece sobre o detetado)"
    },
    "confirmed_country": {
      "type": "string",
      "enum": [
        "portugal",
        "spain",
        "france"
      ],
      "enumColors": [
        "green",
        "yellow",
        "blue"
      ],
      "description": "Pa\u00eds confirmado manualmente pelo admin (prevalece sobre o detetado)"
    },
    "admin_notes": {
      "type": "string",
      "description": "Notas do admin sobre a revis\u00e3o"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Admin que reviu a conta"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date-time",
      "description": "Quando a revis\u00e3o foi decidida"
    },
    "professional_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Tipos profissionais encontrados nos perfis de origem"
    },
    "professional_profile_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs dos perfis profissionais que sustentam este registo"
    },
    "source_signature": {
      "type": "string",
      "description": "Assinatura dos dados de origem \u2014 garante migra\u00e7\u00e3o idempotente"
    },
    "last_synced_date": {
      "type": "string",
      "format": "date-time",
      "description": "Quando este registo foi sincronizado pela \u00faltima vez"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}