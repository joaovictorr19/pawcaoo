{
  "name": "AccountRegistry",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email da conta (chave est\u00e1vel do registo)"
    },
    "user_id": {
      "type": "string",
      "description": "ID da conta de autentica\u00e7\u00e3o"
    },
    "display_name": {
      "type": "string",
      "description": "Nome de exibi\u00e7\u00e3o no momento da sincroniza\u00e7\u00e3o"
    },
    "auth_role": {
      "type": "string",
      "description": "Papel de autentica\u00e7\u00e3o (admin/user) \u2014 informativo, n\u00e3o \u00e9 permiss\u00e3o de regime"
    },
    "regime": {
      "type": "string",
      "enum": [
        "customer",
        "walker",
        "trainer",
        "hotel",
        "shop"
      ],
      "enumColors": [
        "gray",
        "green",
        "purple",
        "blue",
        "yellow"
      ],
      "description": "Regime can\u00f3nico da conta (Cliente/Passeador/Treinador/Hotel/Loja)"
    },
    "country": {
      "type": "string",
      "enum": [
        "portugal",
        "spain",
        "france"
      ],
      "enumColors": [
        "green",
        "yellow",
        "blue"
      ],
      "description": "Pa\u00eds de opera\u00e7\u00e3o da conta"
    },
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "pending",
        "requires_documents",
        "rejected",
        "not_applicable"
      ],
      "enumColors": [
        "green",
        "yellow",
        "yellow",
        "red",
        "gray"
      ],
      "description": "Estado de verifica\u00e7\u00e3o consolidado"
    },
    "review_state": {
      "type": "string",
      "enum": [
        "ok",
        "missing_country",
        "missing_regime",
        "conflict",
        "no_profile"
      ],
      "enumColors": [
        "green",
        "yellow",
        "yellow",
        "red",
        "gray"
      ],
      "default": "ok",
      "description": "Estado de revis\u00e3o administrativa"
    },
    "review_notes": {
      "type": "string",
      "description": "Detalhe leg\u00edvel do motivo de revis\u00e3o"
    },
    "professional_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Tipos profissionais encontrados nos perfis de origem"
    },
    "professional_profile_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs dos perfis profissionais que sustentam este registo"
    },
    "source_signature": {
      "type": "string",
      "description": "Assinatura dos dados de origem \u2014 garante migra\u00e7\u00e3o idempotente"
    },
    "last_synced_date": {
      "type": "string",
      "format": "date-time",
      "description": "Quando este registo foi sincronizado pela \u00faltima vez"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}