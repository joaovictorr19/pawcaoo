{
  "name": "HotelGuestProfile",
  "type": "object",
  "properties": {
    "hotel_profile_id": {
      "type": "string",
      "description": "ID do WalkerProfile do hotel"
    },
    "hotel_email": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "owner_phone": {
      "type": "string"
    },
    "owner_photo_url": {
      "type": "string",
      "description": "Foto de perfil do cliente (sincronizada do UserProfile do dono)"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "veterinarian_name": {
      "type": "string"
    },
    "veterinarian_phone": {
      "type": "string"
    },
    "dogs": {
      "type": "array",
      "description": "C\u00e3es recorrentes do h\u00f3spede com info persistente (vers\u00e3o do hotel edit\u00e1vel)",
      "items": {
        "type": "object",
        "properties": {
          "dog_name": {
            "type": "string"
          },
          "dog_breed": {
            "type": "string"
          },
          "dog_size": {
            "type": "string",
            "enum": [
              "small",
              "medium",
              "large",
              "extra_large"
            ]
          },
          "dog_age": {
            "type": "number"
          },
          "photo_url": {
            "type": "string"
          },
          "persistent_medical_notes": {
            "type": "string",
            "description": "Notas m\u00e9dicas persistentes (alergias, condi\u00e7\u00f5es) \u2014 vers\u00e3o edit\u00e1vel pelo hotel"
          },
          "behavioral_profile": {
            "type": "string",
            "description": "Perfil comportamental acumulado \u2014 vers\u00e3o edit\u00e1vel pelo hotel"
          },
          "accustomed_to_being_alone": {
            "type": "boolean",
            "default": false,
            "description": "Se o c\u00e3o est\u00e1 habituado a estar sozinho"
          },
          "vaccine_expiry": {
            "type": "string",
            "format": "date"
          },
          "vaccine_document_url": {
            "type": "string"
          },
          "owner_snapshot": {
            "type": "object",
            "description": "Snapshot dos dados fornecidos pelo dono (DogProfile) na \u00faltima sincroniza\u00e7\u00e3o. N\u00e3o \u00e9 editado pelo hotel \u2014 serve como refer\u00eancia para detetar atualiza\u00e7\u00f5es do dono.",
            "properties": {
              "breed": {
                "type": "string"
              },
              "age": {
                "type": "number"
              },
              "weight": {
                "type": "number"
              },
              "size": {
                "type": "string"
              },
              "gender": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "photo_url": {
                "type": "string"
              },
              "medical_conditions": {
                "type": "string"
              },
              "medications": {
                "type": "string"
              },
              "allergies": {
                "type": "string"
              },
              "behavioral_notes": {
                "type": "string"
              },
              "energy_level": {
                "type": "string"
              },
              "socialization": {
                "type": "string"
              },
              "accustomed_to_being_alone": {
                "type": "boolean"
              },
              "vet_name": {
                "type": "string"
              },
              "vet_phone": {
                "type": "string"
              },
              "vet_clinic_name": {
                "type": "string"
              },
              "vet_address": {
                "type": "string"
              },
              "vaccination_date": {
                "type": "string"
              },
              "is_vaccinated": {
                "type": "boolean"
              },
              "is_neutered": {
                "type": "boolean"
              },
              "feeding_instructions": {
                "type": "string"
              },
              "special_care_notes": {
                "type": "string"
              },
              "microchip_number": {
                "type": "string"
              },
              "emergency_contact_name": {
                "type": "string"
              },
              "emergency_contact_phone": {
                "type": "string"
              },
              "date_of_birth": {
                "type": "string"
              }
            }
          },
          "owner_snapshot_date": {
            "type": "string",
            "format": "date-time",
            "description": "Quando o snapshot do dono foi atualizado pela \u00faltima vez"
          },
          "has_owner_updates": {
            "type": "boolean",
            "default": false,
            "description": "Se o dono atualizou dados do DogProfile ap\u00f3s o \u00faltimo snapshot"
          }
        }
      },
      "default": []
    },
    "total_stays": {
      "type": "number",
      "default": 0,
      "description": "Total de estadias realizadas"
    },
    "total_spent": {
      "type": "number",
      "default": 0,
      "description": "Total gasto em todas as estadias"
    },
    "first_stay_date": {
      "type": "string",
      "format": "date"
    },
    "last_stay_date": {
      "type": "string",
      "format": "date"
    },
    "general_notes": {
      "type": "string",
      "description": "Notas gerais do h\u00f3spede (prefer\u00eancias, alertas)"
    },
    "is_vip": {
      "type": "boolean",
      "default": false,
      "description": "Cliente VIP (frequente ou de valor)"
    },
    "counted_booking_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs das reservas j\u00e1 contabilizadas em total_stays/total_spent \u2014 evita contagem duplicada quando a ficha \u00e9 sincronizada v\u00e1rias vezes (confirma\u00e7\u00e3o + conclus\u00e3o)"
    }
  },
  "required": [
    "hotel_profile_id",
    "owner_name",
    "owner_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.hotel_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.hotel_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.hotel_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.hotel_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}