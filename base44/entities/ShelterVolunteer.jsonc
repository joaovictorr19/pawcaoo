{
  "name": "ShelterVolunteer",
  "type": "object",
  "properties": {
    "shelter_id": {
      "type": "string",
      "description": "ID do abrigo"
    },
    "name": {
      "type": "string",
      "description": "Nome do volunt\u00e1rio"
    },
    "email": {
      "type": "string",
      "description": "Email do volunt\u00e1rio"
    },
    "phone": {
      "type": "string",
      "description": "Telefone do volunt\u00e1rio"
    },
    "role": {
      "type": "string",
      "enum": [
        "walker",
        "cleaner",
        "admin",
        "foster",
        "other"
      ],
      "default": "walker",
      "description": "Fun\u00e7\u00e3o do volunt\u00e1rio"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "Estado do volunt\u00e1rio"
    },
    "notes": {
      "type": "string",
      "description": "Notas internas sobre o volunt\u00e1rio"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio"
    }
  },
  "required": [
    "shelter_id",
    "name",
    "email",
    "role"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}