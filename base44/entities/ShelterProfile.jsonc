{
  "name": "ShelterProfile",
  "type": "object",
  "properties": {
    "shelter_name": {
      "type": "string",
      "description": "Nome do abrigo ou organiza\u00e7\u00e3o de resgate"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o geral e declara\u00e7\u00e3o de miss\u00e3o"
    },
    "logo_url": {
      "type": "string",
      "description": "URL do logotipo"
    },
    "cover_photo_url": {
      "type": "string",
      "description": "URL da foto de capa"
    },
    "contact_email": {
      "type": "string",
      "description": "E-mail de contacto p\u00fablico"
    },
    "contact_phone": {
      "type": "string",
      "description": "Telefone de contacto p\u00fablico"
    },
    "website_url": {
      "type": "string",
      "description": "Website URL"
    },
    "location_address": {
      "type": "string",
      "description": "Morada f\u00edsica completa"
    },
    "location_city": {
      "type": "string",
      "description": "Cidade"
    },
    "opening_hours": {
      "type": "string",
      "description": "Hor\u00e1rio de funcionamento para visitas"
    },
    "services_offered": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Servi\u00e7os oferecidos (ex: vacina\u00e7\u00e3o, esteriliza\u00e7\u00e3o, treino)"
    },
    "social_facebook": {
      "type": "string",
      "description": "URL do perfil do Facebook"
    },
    "social_instagram": {
      "type": "string",
      "description": "URL do perfil do Instagram"
    },
    "adoption_policy": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o das pol\u00edticas e procedimentos de ado\u00e7\u00e3o"
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "description": "Status verificado"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Status do pedido de verifica\u00e7\u00e3o"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Motivo de rejei\u00e7\u00e3o se rejeitado"
    }
  },
  "required": [
    "shelter_name",
    "contact_email",
    "location_city"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "verification_status": "approved"
        },
        {
          "is_verified": true
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}