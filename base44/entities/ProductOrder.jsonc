{
  "name": "ProductOrder",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "N\u00famero \u00fanico da encomenda"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "partner_id": {
      "type": "string",
      "description": "ID do perfil do parceiro (WalkerProfile/TrainerProfile)"
    },
    "partner_name": {
      "type": "string",
      "description": "Nome do parceiro vendedor"
    },
    "partner_company_email": {
      "type": "string",
      "description": "Email do parceiro vendedor (\u00e2ncora de acesso)"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "product_image": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total_price": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "subtotal": {
      "type": "number"
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "coupon_code": {
      "type": "string"
    },
    "shipping_fee": {
      "type": "number",
      "default": 0
    },
    "total_amount": {
      "type": "number"
    },
    "wallet_used": {
      "type": "number",
      "default": 0,
      "description": "Valor pago com saldo PawC\u00e3o (carteira universal)"
    },
    "commission_amount": {
      "type": "number",
      "default": 0,
      "description": "Comiss\u00e3o da plataforma retida"
    },
    "partner_net_amount": {
      "type": "number",
      "default": 0,
      "description": "Valor l\u00edquido do parceiro (total - comiss\u00e3o)"
    },
    "delivery_method": {
      "type": "string",
      "enum": [
        "shipping",
        "pickup",
        "with_stay"
      ],
      "default": "pickup",
      "description": "shipping=entrega ao domic\u00edlio, pickup=recolha no local, with_stay=adicionado \u00e0 pr\u00f3xima estadia"
    },
    "delivery_notes": {
      "type": "string",
      "description": "Notas de entrega/recolha combinadas com o parceiro"
    },
    "booking_id": {
      "type": "string",
      "description": "ID da reserva HotelBooking associada (quando delivery_method=with_stay ou mimo)"
    },
    "dog_name": {
      "type": "string",
      "description": "Nome do c\u00e3o que recebe o mimo/produto na estadia"
    },
    "is_pawcao_gift": {
      "type": "boolean",
      "default": false,
      "description": "True se for mimo gr\u00e1tis oferecido pela PawC\u00e3o (sem pagamento)"
    },
    "mimo_photo_url": {
      "type": "string",
      "description": "Foto do c\u00e3o feliz com o mimo, publicada pelo hotel no di\u00e1rio"
    },
    "mimo_delivered_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o hotel entregou o mimo e publicou a foto no di\u00e1rio"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "processing",
        "shipped",
        "delivered",
        "cancelled"
      ],
      "default": "pending"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed",
        "refunded"
      ],
      "default": "pending"
    },
    "payment_method": {
      "type": "string",
      "description": "stripe, wallet ou mixed"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o pagamento foi confirmado"
    },
    "stripe_payment_intent_id": {
      "type": "string"
    },
    "shipping_address": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "country": {
          "type": "string"
        }
      }
    },
    "tracking_number": {
      "type": "string"
    }
  },
  "required": [
    "customer_email",
    "items",
    "total_amount",
    "partner_company_email"
  ],
  "rls": {
    "create": {
      "data.customer_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "data.partner_company_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.partner_company_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}