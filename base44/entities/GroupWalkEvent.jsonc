{
  "name": "GroupWalkEvent",
  "type": "object",
  "properties": {
    "professional_email": {
      "type": "string",
      "description": "Email do profissional organizador"
    },
    "professional_name": {
      "type": "string",
      "description": "Nome do profissional organizador"
    },
    "professional_profile_id": {
      "type": "string",
      "description": "ID do perfil do profissional"
    },
    "title": {
      "type": "string",
      "description": "Nome do passeio em grupo"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do evento"
    },
    "location": {
      "type": "string",
      "description": "Local do passeio"
    },
    "pickup_method": {
      "type": "string",
      "enum": [
        "walker_pickup",
        "meeting_point"
      ],
      "default": "meeting_point",
      "description": "walker_pickup = profissional vai buscar; meeting_point = ponto de encontro"
    },
    "meeting_point_address": {
      "type": "string",
      "description": "Endere\u00e7o do ponto de encontro (quando pickup_method=meeting_point)"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "description": "Data do passeio"
    },
    "event_time": {
      "type": "string",
      "description": "Hora de in\u00edcio"
    },
    "duration_minutes": {
      "type": "number",
      "default": 60,
      "description": "Dura\u00e7\u00e3o em minutos"
    },
    "price_per_dog": {
      "type": "number",
      "default": 0,
      "description": "Pre\u00e7o por c\u00e3o"
    },
    "capacity_total": {
      "type": "number",
      "default": 5,
      "description": "N\u00famero m\u00e1ximo de c\u00e3es permitidos (lota\u00e7\u00e3o total)"
    },
    "capacity_available": {
      "type": "number",
      "default": 5,
      "description": "Vagas dispon\u00edveis \u2014 decrementado imediatamente no checkout, restaurado se pagamento expirar"
    },
    "accepted_sizes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "small",
          "medium",
          "large",
          "extra_large"
        ]
      },
      "default": [],
      "description": "Tamanhos aceites"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "full",
        "cancelled",
        "completed"
      ],
      "default": "open",
      "description": "Estado do evento"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "owner_email": {
            "type": "string"
          },
          "owner_name": {
            "type": "string"
          },
          "dog_id": {
            "type": "string"
          },
          "dog_name": {
            "type": "string"
          },
          "dog_size": {
            "type": "string",
            "enum": [
              "small",
              "medium",
              "large",
              "extra_large"
            ]
          },
          "payment_status": {
            "type": "string",
            "enum": [
              "pending",
              "paid",
              "expired"
            ],
            "default": "pending"
          },
          "payment_expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "Data/hora limite para pagamento (5 min ap\u00f3s in\u00edcio do checkout). Se n\u00e3o pagar, vaga \u00e9 libertada."
          },
          "booking_id": {
            "type": "string",
            "description": "ID da reserva associada"
          }
        }
      },
      "default": [],
      "description": "Participantes inscritos (pending = a pagar, paid = confirmado)"
    }
  },
  "required": [
    "professional_email",
    "professional_name",
    "title",
    "event_date",
    "event_time",
    "location"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.professional_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.professional_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}