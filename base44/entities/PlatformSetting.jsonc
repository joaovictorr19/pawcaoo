{
  "name": "PlatformSetting",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Chave \u00fanica da configura\u00e7\u00e3o (ex: hotel_addon_commission_rate)"
    },
    "value": {
      "type": "number",
      "description": "Valor num\u00e9rico da configura\u00e7\u00e3o"
    },
    "label": {
      "type": "string",
      "description": "Etiqueta amig\u00e1vel para exibi\u00e7\u00e3o no admin"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da configura\u00e7\u00e3o"
    },
    "category": {
      "type": "string",
      "enum": [
        "commission",
        "general",
        "feature_flag"
      ],
      "default": "general",
      "description": "Categoria da configura\u00e7\u00e3o"
    }
  },
  "required": [
    "key",
    "value"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}