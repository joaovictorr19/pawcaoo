{
  "name": "BookingStatusUpdate",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string",
      "description": "ID da reserva"
    },
    "company_id": {
      "type": "string",
      "description": "ID da empresa (se despachado por empresa)"
    },
    "employee_email": {
      "type": "string",
      "description": "Email do funcion\u00e1rio respons\u00e1vel"
    },
    "employee_name": {
      "type": "string",
      "description": "Nome do funcion\u00e1rio"
    },
    "status": {
      "type": "string",
      "enum": [
        "assigned",
        "acknowledged",
        "on_the_way",
        "arrived",
        "in_progress",
        "completed",
        "issue"
      ],
      "description": "Status atual"
    },
    "previous_status": {
      "type": "string",
      "description": "Status anterior"
    },
    "update_message": {
      "type": "string",
      "description": "Mensagem de atualiza\u00e7\u00e3o"
    },
    "latitude": {
      "type": "number",
      "description": "Localiza\u00e7\u00e3o atual (latitude)"
    },
    "longitude": {
      "type": "number",
      "description": "Localiza\u00e7\u00e3o atual (longitude)"
    },
    "photo_url": {
      "type": "string",
      "description": "Foto de comprova\u00e7\u00e3o"
    },
    "estimated_arrival": {
      "type": "string",
      "format": "date-time",
      "description": "Previs\u00e3o de chegada"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionais"
    }
  },
  "required": [
    "booking_id",
    "employee_email",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.employee_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.employee_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.employee_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}